{
	"name": "ludaskia",
	"version": "0.1.0",
	"private": true,
	"license": "UNLICENSED",
	"type": "module",
	"description": "Entraînement aux automatismes en maths et en français (CE2, CM1), ludique et chronométré.",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"preview": "vite preview",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"typecheck": "tsc --noEmit",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"verify": "npm run format:check && npm run lint && npm run typecheck && npm test",
		"verify:full": "npm run verify && npm run test:e2e",
		"prepare": "husky",
		"forest:gen": "node tools/forest/generate-forest.mjs 15 14 public/foret-pied.svg",
		"verbs:gen": "node tools/verbs/generate-verbs.mjs",
		"og:gen": "node tools/og-image/generate.mjs"
	},
	"engines": {
		"node": ">=20"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.13.0",
		"@eslint/js": "^10.0.1",
		"@phosphor-icons/core": "^2.1.1",
		"@playwright/test": "^1.62.1",
		"eslint": "^10.8.1",
		"eslint-config-prettier": "^10.1.8",
		"fast-check": "^4.9.0",
		"french-verbs": "^5.4.0",
		"french-verbs-lefff": "^3.4.0",
		"happy-dom": "^20.11.2",
		"husky": "^9.1.7",
		"prettier": "^3.9.6",
		"sass": "^1.102.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.67.0",
		"vite": "^8.2.1",
		"vitest": "^4.1.10"
	}
}
