{
	"compilerOptions": {
		"target": "ES2020",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"isolatedModules": true,
		"resolveJsonModule": true,
		"noEmit": true,
		"lib": ["ES2020", "DOM", "DOM.Iterable"],
		"types": ["vite/client", "vitest/globals"]
	},
	/* `src/sw.ts` est vérifié à part (tsconfig.sw.json) : c'est un worker, ses globales
	   viennent de `lib.webworker` et non du DOM. */
	"include": ["src", "tests", "vite.config.ts"],
	"exclude": ["src/sw.ts"]
}
