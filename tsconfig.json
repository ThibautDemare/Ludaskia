{
	"compilerOptions": {
		"target": "ES2020",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		/* Un seul JS entre dans le programme : `tools/contrast/wcag.js`, importé par
		   `tests/contraste-tokens.test.ts` (#582). Il reste en JS parce que l'autre
		   appelant, `tools/contrast/contrast.mjs`, s'exécute sans build ; ses types
		   viennent de ses annotations JSDoc. `checkJs` reste à false : on TYPE ce
		   fichier, on ne le type-vérifie pas. Aucun autre .js sous `src/` ni `tests/`. */
		"allowJs": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"isolatedModules": true,
		"resolveJsonModule": true,
		"noEmit": true,
		"lib": ["ES2020", "DOM", "DOM.Iterable"],
		"types": ["vite/client", "vitest/globals", "vite-plugin-pwa/client"]
	},
	/* `src/sw.ts` est vérifié à part (tsconfig.sw.json) : c'est un worker, ses globales
	   viennent de `lib.webworker` et non du DOM. */
	"include": ["src", "tests", "vite.config.ts"],
	"exclude": ["src/sw.ts"]
}
