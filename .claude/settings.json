			"PowerShell(npx tsc --noEmit *)",
			"PowerShell(git status*)",
			"PowerShell(git log*)",
			"PowerShell(git diff*)",
			"PowerShell(git show*)",
			"PowerShell(git branch*)",
			"PowerShell(git rev-parse*)",
			"PowerShell(git remote*)",
			"PowerShell(git ls-files*)",
