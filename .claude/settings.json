			"Bash(git check-ignore *)",
			"Bash(git add)",
			"Bash(git add *)",
			"Bash(git commit -m *)",
			"Bash(git stash)",
			"Bash(git stash *)",
			"Bash(npm run build)",
			"Bash(npm run build *)",
			"Bash(npx prettier --write *)",
